{
  "name": "sample-app-mobile-e2e-runner",
  "private": true,
  "version": "0.0.0",
  "devDependencies": {
    "@cucumber/cucumber": "^9",
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/cli": "^8",
    "@wdio/cucumber-framework": "^8",
    "@wdio/local-runner": "^8",
    "@wdio/spec-reporter": "^8",
    "allure-commandline": "^2.34.1",
    "webdriverio": "^8"
  },
  "scripts": {
    "test": "wdio run ../tests/e2e/config/wdio.android.local.emu.conf.js",
    "test:spec": "wdio run ../tests/e2e/config/wdio.android.local.emu.conf.js --spec",
    "test:nav": "wdio run ../tests/e2e/config/wdio.android.local.emu.conf.js --spec ../tests/e2e/features/navigation-checkout.feature",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report"
  }
}
